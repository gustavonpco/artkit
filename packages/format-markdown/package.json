{
  "name": "@artkit-ai/format-markdown",
  "version": "0.1.0",
  "description": "Markdown (GFM with frontmatter) native format for artkit: dialect, anchors, section operations, compact reading, lint and Tiptap-compatible parsing.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "artkit",
    "ai",
    "agents",
    "artifacts",
    "markdown"
  ],
  "exports": {
    ".": {
      "@artkit/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./export": {
      "@artkit/source": "./src/export/index.ts",
      "types": "./dist/export/index.d.ts",
      "import": "./dist/export/index.js"
    },
    "./package.json": "./package.json",
    "./react": {
      "@artkit/source": "./src/react/index.ts",
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gustavonpco/artkit.git",
    "directory": "packages/format-markdown"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@artkit-ai/core": "workspace:^",
    "@artkit-ai/react": "workspace:^",
    "@tiptap/core": "^3.32.3",
    "@tiptap/extension-table": "^3.32.3",
    "@tiptap/extension-task-item": "^3.32.3",
    "@tiptap/extension-task-list": "^3.32.3",
    "@tiptap/markdown": "^3.32.3",
    "@tiptap/pm": "^3.32.3",
    "@tiptap/react": "^3.32.3",
    "@tiptap/starter-kit": "^3.32.3",
    "lucide-react": "1.68.0",
    "micromark": "^4.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
