{
  "name": "@artkit-ai/kind-document",
  "version": "0.1.0",
  "description": "Rich document artifact kind (Markdown in/out) with renderer, TipTap editor and docx/md/html exporters.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "artkit",
    "ai",
    "agents",
    "artifacts"
  ],
  "exports": {
    ".": {
      "@artkit/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "@artkit/source": "./src/react/index.ts",
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./edit": {
      "@artkit/source": "./src/edit/index.ts",
      "types": "./dist/edit/index.d.ts",
      "import": "./dist/edit/index.js"
    },
    "./export": {
      "@artkit/source": "./src/export/index.ts",
      "types": "./dist/export/index.d.ts",
      "import": "./dist/export/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gustavonpco/artkit.git",
    "directory": "packages/kind-document"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@artkit-ai/core": "workspace:^",
    "@artkit-ai/react": "workspace:^",
    "@tiptap/core": "^3.32.2",
    "@tiptap/extension-subscript": "^3.32.2",
    "@tiptap/extension-superscript": "^3.32.2",
    "@tiptap/extension-table": "^3.32.2",
    "@tiptap/extension-text-align": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "docx": "^9.15.2",
    "lucide-react": "^1.68.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
