{
  "tipo": "planilha",
  "schemaVersion": 1,
  "titulo": "Estimativa de esforço",
  "moeda": "BRL",
  "notas": "1. Valores sem impostos.\n2. Horas revisadas com o cliente.",
  "parametros": [
    { "id": "valor_hora", "rotulo": "Valor da hora", "tipo": "moeda", "fill": "user", "valor": 150 },
    { "id": "margem", "rotulo": "Margem", "tipo": "percentual", "fill": "user", "valor": 0.2 }
  ],
  "colunas": [
    { "id": "atividade", "rotulo": "Atividade", "tipo": "texto", "fill": "ai" },
    { "id": "inicio", "rotulo": "Início previsto", "tipo": "data", "fill": "ai" },
    { "id": "horas", "rotulo": "Horas", "tipo": "numero", "fill": "ai_suggested" },
    {
      "id": "subtotal",
      "rotulo": "Subtotal",
      "tipo": "moeda",
      "fill": "computed",
      "formula": "horas * param(valor_hora)"
    }
  ],
  "linhas": [
    {
      "id": "r1",
      "grupo": "Construção",
      "celulas": { "atividade": "Login", "inicio": "2026-11-09", "horas": 10 }
    },
    {
      "id": "r2",
      "grupo": "Construção",
      "celulas": { "atividade": "Relatórios", "inicio": "2026-11-16", "horas": 20.5 }
    },
    {
      "id": "r3",
      "grupo": "Implantação",
      "celulas": { "atividade": "Treinamento & suporte", "inicio": "2026-12-01", "horas": 8 }
    }
  ],
  "totais": [
    { "id": "total_horas", "rotulo": "Total de horas", "op": "soma", "coluna": "horas", "formato": "numero" },
    { "id": "total", "rotulo": "Total", "op": "soma", "coluna": "subtotal", "formato": "moeda" },
    {
      "id": "por_grupo",
      "rotulo": "Subtotal por grupo",
      "op": "soma",
      "coluna": "subtotal",
      "agruparPor": "grupo"
    },
    {
      "id": "com_margem",
      "rotulo": "Total com margem",
      "op": "formula",
      "formula": "soma(subtotal) * (1 + param(margem))",
      "formato": "moeda"
    }
  ]
}
